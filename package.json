{
  "name": "arima-ficha",
  "private": true,
  "version": "0.1.0",
  "description": "ARIMA FICHA — registro horario de Arima Cool Tour (PWA). Fase 1.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "dev:emulators": "vite --mode emulators",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && npm --prefix functions run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-arima-ficha \"vitest run --config vitest.rules.config.ts\"",
    "test:functions": "npm --prefix functions test",
    "test:e2e": "playwright test",
    "emulators": "npm --prefix functions run build && firebase emulators:start --project demo-arima-ficha",
    "emulators:seed": "node scripts/seed-emulators.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:functions && npm run build"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "i18next": "^25.10.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^16.6.6",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
