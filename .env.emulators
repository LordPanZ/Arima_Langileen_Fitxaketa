# Modo emuladores locales de Firebase. El prefijo "demo-" del proyecto hace que
# el SDK y la CLI no contacten con ningún proyecto real de Google Cloud.
# No contiene secretos; se versiona a propósito.
VITE_APP_MODE=emulators
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-arima-ficha.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-arima-ficha
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FUNCTIONS_REGION=europe-southwest1
VITE_EMULATOR_HOST=127.0.0.1
