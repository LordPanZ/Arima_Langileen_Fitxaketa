# ─────────────────────────────────────────────────────────────────────────────
# ARIMA FICHA — variables de entorno de la PWA (Vite)
# Copia este archivo a ".env.local" y rellena los valores. ".env.local" está
# en .gitignore: NUNCA lo subas al repositorio.
#
# Nota: la configuración web de Firebase (apiKey, appId…) NO es un secreto,
# identifica el proyecto. La seguridad la dan las reglas de Firestore, la
# validación en Cloud Functions y (fase 2) App Check. Aun así, no se versiona.
# ─────────────────────────────────────────────────────────────────────────────

# Modo de la app: "demo" (sin Firebase, datos ficticios), "emulators" o "firebase"
VITE_APP_MODE=demo

# Configuración del proyecto Firebase (Consola → Configuración del proyecto)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Región de Cloud Functions (UE para RGPD)
VITE_FUNCTIONS_REGION=europe-southwest1

# Emuladores locales (solo con VITE_APP_MODE=emulators)
VITE_EMULATOR_HOST=127.0.0.1
